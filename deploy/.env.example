# Copy to .env next to compose.yaml on the target host.
ECUME_IMAGE=ecume:offline
ECUME_BIND_IP=127.0.0.1
ECUME_PORT=8080

# Linux target with an external-to-ECUME API reachable on the internal network.
# Fill in the base URL (usually ending in /v1), model and key on the target only.
LLM_ENABLED=false
LLM_PROVIDER=api
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_API_KEY=
ECUME_ALLOW_LLM_FALLBACK=false
LLM_TIMEOUT_SECONDS=600
LLM_JSON_MODE=auto
OLLAMA_ENDPOINT=auto

# After saving in Admin, /data/settings.env takes precedence for LLM settings.
# Do not expose ECUME beyond a trusted test environment without auth/TLS.
