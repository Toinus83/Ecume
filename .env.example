# ECUME
ECUME_ENV=production
DATA_DIR=
DATABASE_URL=
ECUME_FRONTEND_PORT=8080
ECUME_BACKEND_PORT=8000
ECUME_API_URL=/api

# LLM : false = analyse locale simple, sans appel externe
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_API_URL=
LLM_API_KEY=changeme
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ECUME_ALLOW_LLM_FALLBACK=false
ECUME_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Fuseki et graphes nommes (desactives par defaut)
FUSEKI_ENABLED=false
FUSEKI_BASE_URL=http://fuseki:3030
FUSEKI_DATASET=ecume
FUSEKI_QUERY_ENDPOINT=/query
FUSEKI_UPDATE_ENDPOINT=/update
FUSEKI_WRITE_MODE=disabled
FUSEKI_GRAPH_ECHO_OWL=graph:echo:reference:owl
FUSEKI_GRAPH_ECHO_VOC=graph:echo:reference:voc
FUSEKI_GRAPH_ECHO_SHACL=graph:echo:reference:shacl
FUSEKI_GRAPH_ECUME_CANDIDATES=graph:ecume:candidates
FUSEKI_GRAPH_ECUME_VALIDATED=graph:ecume:validated
FUSEKI_GRAPH_ECUME_REJECTED=graph:ecume:rejected
FUSEKI_GRAPH_ECUME_PROVENANCE=graph:ecume:provenance
FUSEKI_GRAPH_ECUME_REVIEW=graph:ecume:review

# Echo
ECUME_ECHO_SOURCE=unconfigured
ECUME_ECHO_DEFAULT_DOMAIN=ECHO_RH
ECUME_ECHO_OWL_REFERENCE=
ECUME_ECHO_VOC_REFERENCE=
ECUME_ECHO_SHACL_REFERENCE=

# OntoCast : jeton reserve au futur contrat API, non utilise en mode disabled
ONTOCAST_ENABLED=false
ONTOCAST_API_URL=
ONTOCAST_TOKEN=changeme
ECUME_ONTOCAST_MODE=disabled
ECUME_ONTOCAST_TIMEOUT=120
ECUME_ONTOCAST_EXTRACTION_PROFILE=default
ECUME_ONTOCAST_USE_FUSEKI=false
ECUME_ONTOCAST_LOCAL_FALLBACK=true

# Ontosphere
ONTOSPHERE_URL=
ECUME_ONTOSPHERE_ENABLED=false
ECUME_ONTOSPHERE_SPARQL_URL=
ECUME_ONTOSPHERE_REVIEW_GRAPH=graph:ecume:review

# Authentification RDF : ne jamais placer de vraie valeur dans ce fichier versionne
ECUME_RDF_AUTH_TYPE=none
ECUME_RDF_AUTH_USERNAME=
ECUME_RDF_AUTH_SECRET=changeme
ECUME_RDF_READ_ONLY=true
ECUME_RDF_WRITE_CANDIDATES_ONLY=true
ECUME_RDF_WRITE_VALIDATED=false
